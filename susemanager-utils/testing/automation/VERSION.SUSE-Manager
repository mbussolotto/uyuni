REGISTRY=registry.suse.de
VER=5.2
BASE_CONTAINER=devel/galaxy/manager/$VER/docker/containers/suma-$VER-base
PGSQL_CONTAINER=devel/galaxy/manager/$VER/docker/containers/suma-$VER-pgsql
NODEJS_CONTAINER=devel/galaxy/manager/$VER/docker/containers/suma-$VER-nodejs
REPORTDB_DOC_CONTAINER=devel/galaxy/manager/$VER/docker/containers/suma-$VER-reportdb-docs
# Base version for the idempotency test. All PostgreSQL since this version must be idempotent for the test to pass
# This value is is used if the file for the PR is not found (we assume we are on a branch)
IDEMPOTENCY_SCHEMA_BASE_VERSION='5.1.20'
IDEMPOTENCY_REPORTDB_SCHEMA_BASE_VERSION='5.1.4'
SCHEMA_PACKAGES='susemanager-schema-5.1.20-150750.1.3.noarch.rpm susemanager-schema-utility-5.1.20-150750.1.3.noarch.rpm'
REPORTDB_SCHEMA_PACKAGES='susemanager-schema-5.1.20-150750.1.3.noarch.rpm susemanager-schema-utility-5.1.20-150750.1.3.noarch.rpm uyuni-reportdb-schema-5.1.4-150750.1.12.noarch.rpm'
BRAND_NAME='SUSE Multi-Linux Manager'
